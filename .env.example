# Copie para .env (ignorado pelo git): o docker compose le sozinho.
# Moderacao de desafios por IA na Groq (ADR 0015). A chave quem fornece e o PO;
# nunca a commite. Sem ela, criar desafio responde 503 - nada e aprovado sem
# avaliacao.
IA_API_KEY=
# Opcionais: os padroes ja apontam para a Groq.
# IA_BASE_URL=https://api.groq.com/openai/v1
# IA_MODELO=openai/gpt-oss-120b

# Login com Google (ADR 0021). O Client ID nao e segredo, mas fica aqui para
# cada ambiente usar o seu. Sem ele, a API sobe e o login responde 503.
GOOGLE_CLIENT_ID=

# Chave que assina as sessoes (JWT). Obrigatoria no ambiente publico: sem ela,
# vale o padrao de desenvolvimento, que esta no repositorio. Gere com:
#   openssl rand -base64 48
AUTH_CHAVE=

# Opcional e so para o ambiente local: liga uma conta Google a um usuario ficticio
# dos dados de teste (scripts/demo/vincular-contas.sh). Nao usar na producao.
# DEMO_CONTAS="Apelido=conta@gmail.com"
