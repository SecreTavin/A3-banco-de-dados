{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Debug (Web + API)",
            "configurations": ["Launch API", "Launch Web"],
            "preLaunchTask": "npm: install -w apps/web"
        }
    ],
    "configurations": [
        {
            "name": "Launch API",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/apps/api/EuDuvido.Api/bin/Debug/net10.0/EuDuvido.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/apps/api/EuDuvido.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\\\bNow listening on:\\\\s+(https?://\\\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "preLaunchTask": "dotnet: build"
        },
        {
            "name": "Launch Web",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/apps/web",
            "preLaunchTask": "npm: dev -w apps/web"
        }
    ]
}