{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "npm: install -w apps/web",
        "type": "npm",
        "script": "install",
        "options": {
          "cwd": "${workspaceFolder}/apps/web"
        }
      },
      {
        "label": "npm: dev -w apps/web",
        "type": "npm",
        "script": "dev",
        "options": {
          "cwd": "${workspaceFolder}/apps/web"
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "vite",
          "pattern": {
            "regexp": ".*"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*VITE.*",
            "endsPattern": ".*ready.*"
          }
        }
      }
    ]
  }